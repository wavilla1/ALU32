CHIP ALU32 {

    IN  
        x[32], y[32], z[32],
        zx, nx, zy, ny, f, no,   // Control Hack estándar
        op1, op0;                // 00=Hack | 01=X+Y+Z | 10=Z-X+Y

    OUT 
        out[32],
        zr,
        ng;

    PARTS:

    // =========================
    // 1️⃣ PRE-CONDICIONAMIENTO
    // =========================

    // Zero X
    Mux32(a=x, b=false, sel=zx, out=x1);
    // Negate X
    Not32(in=x1, out=notx1);
    Mux32(a=x1, b=notx1, sel=nx, out=x2);

    // Zero Y
    Mux32(a=y, b=false, sel=zy, out=y1);
    // Negate Y
    Not32(in=y1, out=noty1);
    Mux32(a=y1, b=noty1, sel=ny, out=y2);


    // =========================
    // 2️⃣ PROCESAMIENTO PARALELO
    // =========================

    // ----- ALU Hack estándar -----
    And32(a=x2, b=y2, out=andOut);
    Add32(a=x2, b=y2, out=addOut);
    Mux32(a=andOut, b=addOut, sel=f, out=hackPreOut);

    Not32(in=hackPreOut, out=notHackPreOut);
    Mux32(a=hackPreOut, b=notHackPreOut, sel=no, out=hackOut);


    // ----- X + Y + Z -----
    Add32(a=x, b=y, out=xySum);
    Add32(a=xySum, b=z, out=xyzOut);


    // ----- Z - X + Y -----
    // Calcular -X
    Not32(in=x, out=notX);
    Add32(a=notX, b[0]=true, out=negX);   // complemento a 2

    // Z - X
    Add32(a=z, b=negX, out=zMinusX);

    // (Z - X) + Y
    Add32(a=zMinusX, b=y, out=zMinusXplusYOut);


    // =========================
    // 3️⃣ ETAPA DE SELECCIÓN
    // =========================
    // op1 op0
    //  0   0   → Hack
    //  0   1   → X+Y+Z
    //  1   0   → Z-X+Y

    Mux32(a=hackOut, b=xyzOut, sel=op0, out=sel1);
    Mux32(a=sel1, b=zMinusXplusYOut, sel=op1, out=out);


    // =========================
    // 4️⃣ FLAGS
    // =========================

    // zr = 1 si out == 0
    Or8Way(in=out[0..7], out=o1);
    Or8Way(in=out[8..15], out=o2);
    Or8Way(in=out[16..23], out=o3);
    Or8Way(in=out[24..31], out=o4);

    Or(a=o1, b=o2, out=o12);
    Or(a=o3, b=o4, out=o34);
    Or(a=o12, b=o34, out=orAll);

    Not(in=orAll, out=zr);

    // ng = bit más significativo
    And(a=true, b=out[31], out=ng);
}
