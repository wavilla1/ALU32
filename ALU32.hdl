CHIP ALU32 {

    IN  x1[16], x2[16],
        y1[16], y2[16],
        z1[16], z2[16],
        zx, nx, zy, ny, f, no,
        op1, op0;   // 00=Hack | 01=X+Y+Z | 10=Z-X+Y

    OUT out1[16], out2[16],
        zr,
        ng;

    PARTS:

    // ==================================================
    // 1️⃣ ALU HACK ORIGINAL (NO SE MODIFICA)
    // ==================================================

    ALU16MOD(x=x1, y=y1, zx=zx, nx=nx, zy=zy, ny=ny, f=f, no=no,
             out=hackLow, zr=zr1, ng=ngLow);

    ALU16MOD(x=x2, y=y2, zx=zx, nx=nx, zy=zy, ny=ny, f=f, no=no,
             out=hackHigh, zr=zr2, ng=ngHigh);


    // ==================================================
    // 2️⃣ X + Y + Z
    // ==================================================

    // X + Y
    Add16(a=x1, b=y1, out=xyLow);
    Add16(a=x2, b=y2, out=xyHigh);

    // (X + Y) + Z
    Add16(a=xyLow, b=z1, out=xyzLow);
    Add16(a=xyHigh, b=z2, out=xyzHigh);


    // ==================================================
    // 3️⃣ Z - X + Y
    // ==================================================

    // -X (complemento a 2)
    Not16(in=x1, out=notX1);
    Not16(in=x2, out=notX2);

    Add16(a=notX1, b[0]=true, out=negX1);
    Add16(a=notX2, b=false, out=negX2);

    // Z - X
    Add16(a=z1, b=negX1, out=zMinusXLow);
    Add16(a=z2, b=negX2, out=zMinusXHigh);

    // (Z - X) + Y
    Add16(a=zMinusXLow, b=y1, out=finalLow);
    Add16(a=zMinusXHigh, b=y2, out=finalHigh);


    // ==================================================
    // 4️⃣ ETAPA DE SELECCIÓN
    // ==================================================
    // op1 op0
    //  0   0   → Hack
    //  0   1   → X+Y+Z
    //  1   0   → Z-X+Y

    // Primera capa
    Mux16(a=hackLow, b=xyzLow, sel=op0, out=selLow1);
    Mux16(a=hackHigh, b=xyzHigh, sel=op0, out=selHigh1);

    // Segunda capa
    Mux16(a=selLow1, b=finalLow, sel=op1, out=out1);
    Mux16(a=selHigh1, b=finalHigh, sel=op1, out=out2);


    // ==================================================
    // 5️⃣ FLAGS
    // ==================================================

    // Zero flag
    And(a=zr1, b=zr2, out=zr);

    // Negative flag (bit más significativo)
    And(a=true, b=out2[15], out=ng);
}
