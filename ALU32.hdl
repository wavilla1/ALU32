CHIP ALU32{
    IN x1[16], x2[16],y1[16],y2[16], nx, ny, zx, zy, f, no;
    OUT out1[16], out2[16], zr, ng, overflow;
    
    PARTS:
        ALU16(x=x1,y=y1,zx=zx,nx=nx,zy=zy,ny=ny,f=f,no=no,carryLlegada=false,out=out1,zr=zr1,ng = ng1,carryOut31=carry1,overflow=overflowLow);
        ALU16(x=x2,y=y2,zx=zx,nx=nx,zy=zy,ny=ny,f=f,no=no,carryLlegada=carry1,out=out2,zr=zr2,out[15] = ng,carryOut31=carryOut31,overflow=overflow);
        And(a=zr1,b=zr2,out=zr);

}
