CHIP ALU32 {

    IN  x[32], y[32], z[32],
        sel[2];

    OUT out[32], zr, ng, ov;

    PARTS:

    // X + Y
    Adder32(a=x, b=y, carryIn=false,
            out=xy, carryOut=cxy, carryIntoMSB=cin_xy);

    // X + Y + Z
    Adder32(a=xy, b=z, carryIn=false,
            out=xyz, carryOut=cxyz, carryIntoMSB=cin_xyz);

    // -------- Z - X --------
    Not32(in=x, out=notx);

    // complemento a 2 usando carryIn = true
    Adder32(a=notx, b=false, carryIn=true,
            out=negx, carryOut=d1, carryIntoMSB=d2);

    // Z + (-X)
    Adder32(a=z, b=negx, carryIn=false,
            out=zx, carryOut=czx, carryIntoMSB=cin_zx);

    // Z - X + Y
    Adder32(a=zx, b=y, carryIn=false,
            out=zxy, carryOut=czxy, carryIntoMSB=cin_zxy);

    // MUX
    Mux4Way32(
        a=false,
        b=xyz,
        c=zxy,
        d=false,
        sel=sel,
        out=out
    );

    // Zero
    Or32Way(in=out, out=anyBit);
    Not(in=anyBit, out=zr);

    // Negative
    And(a=out[31], b=true, out=ng);

    // Overflow
    Xor(a=cin_xyz, b=cxyz, out=ov_xyz);
    Xor(a=cin_zxy, b=czxy, out=ov_zxy);

    Mux(a=ov_xyz, b=ov_zxy, sel=sel[1], out=ov);
}
