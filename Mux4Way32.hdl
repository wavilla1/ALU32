CHIP Mux4Way32 {
    IN  a[32], b[32], c[32], d[32], sel[2];
    OUT out[32];

    PARTS:
    Mux4Way16(
        a=a[0..15], b=b[0..15],
        c=c[0..15], d=d[0..15],
        sel=sel,
        out=out[0..15]
    );

    Mux4Way16(
        a=a[16..31], b=b[16..31],
        c=c[16..31], d=d[16..31],
        sel=sel,
        out=out[16..31]
    );
}
