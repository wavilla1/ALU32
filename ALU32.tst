load ALU32.hdl;
output-file ALU32.out;
output-list x%B32.32.1 y%B32.32.1 z%B32.32.1 sel%B2.2.1 out%B32.32.1 zr%B1.1.1 ng%B1.1.1 ov%B1.1.1;


// ======================
// CASO 1: X+Y+Z
// ======================
set x %B00000000000000000000000000000001;
set y %B00000000000000000000000000000001;
set z %B00000000000000000000000000000001;
set sel %B01;
eval;
output;


// ======================
// CASO 2: Z - X + Y
// ======================
set x %B00000000000000000000000000000001;
set y %B00000000000000000000000000000010;
set z %B00000000000000000000000000000100;
set sel %B10;
eval;
output;



