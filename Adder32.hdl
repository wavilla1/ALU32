CHIP Adder32 {
    IN  a[32], b[32];
    OUT out[32], carryOut, carryIntoMSB;

    PARTS:

    // Lower 16 bits
    Add16(
        a=a[0..15],
        b=b[0..15],
        carryIn=false,
        out=out[0..15],
        carryOut=c16
    );

    // Upper 16 bits
    Add16(
        a=a[16..31],
        b=b[16..31],
        carryIn=c16,
        out=out[16..31],
        carryOut=carryOut
    );

    // carryIntoMSB es el carry que entra al bit 31
    // En un Adder ripple de 16 bits,
    // ese es el carry que entra al segundo Add16
    // pero específicamente el carry que entra al último FullAdder

    // Necesitamos capturarlo desde Add16.
    // Por simplicidad arquitectónica:
    // carryIntoMSB = carry que entra al segundo bloque

    And(a=c16, b=true, out=carryIntoMSB);
}
