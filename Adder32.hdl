CHIP Adder32 {
    IN a[32], b[32];
    OUT out[32], carryOut;

    PARTS:

    // Parte baja (bits 0–15)
    Add16(
        a=a[0..15],
        b=b[0..15],
        out=out[0..15],
        carry=c1
    );

    // Parte alta (bits 16–31)
    Add16(
        a=a[16..31],
        b=b[16..31],
        carry=c1,
        out=out[16..31],
        carry=carryOut
    );
}
