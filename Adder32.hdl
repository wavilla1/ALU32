CHIP Adder32 {
    IN a[32], b[32];
    OUT out[32], carryOut, carryIntoMSB;

    PARTS:

    // Parte baja
    Add16(
        a=a[0..15],
        b=b[0..15],
        out=out[0..15],
        carry=c1
    );

    // Parte alta
    Add16(
        a=a[16..31],
        b=b[16..31],
        carry=c1,
        out=out[16..31],
        carry=carryOut
    );

    // carryIntoMSB = carry que entra al bit 31
    And(a=c1, b=true, out=carryIntoMSB);
}
