CHIP Adder32 {
    IN a[32], b[32];
    OUT out[32], carryOut, carryIntoMSB;

    PARTS:

    // Parte baja (bits 0–15)
    Add16(
        a=a[0..15],
        b=b[0..15],
        out=out[0..15],
        carry=c1
    );

    // Parte alta (bits 16–31)
    Add16(
        a=a[16..31],
        b=b[16..31],
        carry=c1,
        out=out[16..31],
        carry=carryOut
    );

    // El carry que entra al MSB (bit 31)
    // Es el carry interno del último Add16
    // Como Add16 no lo expone directamente,
    // usamos carryOut como referencia
    // (carryIntoMSB = carry que entra a bit 31)
    // En arquitectura real sería el carry del bit 30
    // Para Nand2Tetris usamos el carry final del bloque alto

    And(a=carryOut, b=true, out=carryIntoMSB);
}
